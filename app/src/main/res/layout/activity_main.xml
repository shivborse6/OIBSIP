

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unit Converter"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#173B67"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Convert measurements easily"
            android:textSize="16sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Category"
            android:textStyle="bold"
            android:textColor="#173B67"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter Value"
            android:textStyle="bold"
            android:textColor="#173B67"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/valueInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter a number"
            android:inputType="numberDecimal|numberSigned"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="From Unit"
            android:textStyle="bold"
            android:textColor="#173B67"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/fromSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To Unit"
            android:textStyle="bold"
            android:textColor="#173B67"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/toSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/convertButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONVERT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2457A7" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your result will appear here"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#173B67"
            android:gravity="center"
            android:padding="20dp"
            android:layout_marginTop="24dp"
            android:background="#E0EAF9" />

    </LinearLayout>
</ScrollView>
    ```